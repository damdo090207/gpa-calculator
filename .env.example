# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# Supabase 대시보드 → Project Settings → API Keys 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key(sb_publishable_...) 또는 예전 anon key 둘 다 동작합니다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# origin 헤더가 없을 때만 쓰는 예비 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
